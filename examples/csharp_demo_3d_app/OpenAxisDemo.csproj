<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Support newer SDK-only installs, including the repository's mise .NET 9. -->
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../demo_3d_scene/scene.json" LogicalName="scene.json" />
    <EmbeddedResource Include="../demo_3d_scene/test-boxes.json" LogicalName="test-boxes.json" />
    <EmbeddedResource Include="../demo_3d_scene/probes.json" LogicalName="probes.json" />
    <PackageReference Include="Raylib-cs" Version="7.0.2" />
    <ProjectReference Include="../../cs/OpenAxis/OpenAxis.csproj" />
  </ItemGroup>
</Project>
